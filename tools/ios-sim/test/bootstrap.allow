# Where simboot.sh's bootstrap may differ from the golden master (bootstrap.golden), one path per line with why. A
# path here must still differ: bootstrap-golden.sh fails on an entry the bootstrap no longer needs.
#
# Darling's own: with it set, the device's IOKit looks up simiokitd (com.apple.iokitsimd) instead of a kernel's IOKit
Bootstrap.Child.IOS_SIMULATOR_IOKITSIMD	Darling's simiokitd
Bootstrap.Self.IOS_SIMULATOR_IOKITSIMD	Darling's simiokitd
# from the caller and the device type, which the test doesn't have: the HID system manager is the caller's
# (SIM_EXTRA_ENVIRONMENT), the legacy asset suffix comes from the device type's profile.plist environment
Bootstrap.Child.SIMULATOR_HID_SYSTEM_MANAGER	the caller's
Bootstrap.Self.SIMULATOR_HID_SYSTEM_MANAGER	the caller's
Bootstrap.Child.SIMULATOR_LEGACY_ASSET_SUFFIX	the device type's profile.plist
Bootstrap.Self.SIMULATOR_LEGACY_ASSET_SUFFIX	the device type's profile.plist
# the Mac runner is arm64 and its devices run arm64 and x86_64 apps; this device runs x86_64 only
Bootstrap.Child.SIMULATOR_ARCHS	x86_64 only
Bootstrap.Self.SIMULATOR_ARCHS	x86_64 only
# the device keeps launchd_sim's and its jobs' logs in its data directory (<data>/Library/Logs); a Mac's go to the
# host's ~/Library/Logs/CoreSimulator/<uuid>
Bootstrap.Child.SIMULATOR_LOG_ROOT	logs in the data directory
Bootstrap.Self.SIMULATOR_LOG_ROOT	logs in the data directory
# the same numbers: CoreSimulator writes the screen's scale and pitch with six decimals (3.000000), simdevice.sh as
# the device type's capabilities give them (3)
Bootstrap.Child.SIMULATOR_MAINSCREEN_PITCH	written without decimals
Bootstrap.Self.SIMULATOR_MAINSCREEN_PITCH	written without decimals
Bootstrap.Child.SIMULATOR_MAINSCREEN_SCALE	written without decimals
Bootstrap.Self.SIMULATOR_MAINSCREEN_SCALE	written without decimals
# not set yet. The device loads only SIM_DAEMONS, from one directory of links (Paths[0]), where a Mac gives
# launchd_sim the runtime's job directories and the keys that go with them; AbortOnUnknownIPC and
# RequireDomainBinding wait until a boot shows them safe with Darling's IPC
AbortOnUnknownIPC	not yet
CrashOnSIGTERMTimeout	not yet
ExtensionWatchdog	not yet
LogServiceLifecycle	not yet
LogToFlatFile	not yet
RequireDomainBinding	not yet
SIGTERMTimeout	not yet
UseGuardMalloc	not yet
Bootstrap.BinaryOrderPreference	not yet
Bootstrap.CheckedAllocationsPosixSpawnFlagsGlobal	not yet
Bootstrap.Paths[0]	SIM_DAEMONS' links
Bootstrap.Paths[1]	SIM_DAEMONS' links
Bootstrap.Paths[2]	SIM_DAEMONS' links
Bootstrap.Paths[3]	SIM_DAEMONS' links
